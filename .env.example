# ---- Database ----
DATABASE_URL="postgresql://resolvepay:resolvepay@localhost:5432/resolvepay"

# ---- Modes (explicit; there is no automatic fallback between them) ----
# fixture = simulated payments, no PayPal calls (UI dev + tests)
# sandbox = real PayPal sandbox REST API
PAYMENTS_MODE="fixture"
# fixture = recorded AI outputs; live = call the Anthropic API
AI_MODE="fixture"

# ---- PayPal sandbox (server-side only; required when PAYMENTS_MODE=sandbox) ----
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# From developer.paypal.com > Apps & Credentials > your sandbox app > Webhooks
PAYPAL_WEBHOOK_ID=""

# ---- AI provider (used when AI_MODE=live): "anthropic" or "gemini" ----
AI_PROVIDER="anthropic"

# Anthropic (server-side only; required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Google Gemini (server-side only; required when AI_PROVIDER=gemini)
# Free tier available: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# ---- Merchant auth ----
MERCHANT_PASSWORD="change-me-please"
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=""

# Public base URL of the app (used for same-origin checks, PayPal return URLs, webhook URL)
APP_BASE_URL="http://localhost:3000"
